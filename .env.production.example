# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# NEVER commit this file - use CI/CD secrets
# ==========================================

# Application
NODE_ENV=production
PORT=8787

# Supabase (Production Project)
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Client-side (VITE_ prefix required)
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key
VITE_API_BASE_URL=https://anqor.com

# Session Security (KEEP SECRET - different from staging!)
SESSION_SECRET=your-production-session-secret
JWT_SECRET=your-production-jwt-secret

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Monitoring
SENTRY_DSN=your-production-sentry-dsn
POSTHOG_API_KEY=your-production-posthog-key

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Anqor <noreply@anqor.com>
APP_URL=https://anqor.com
UNSUBSCRIBE_SECRET=your-unsubscribe-secret-key

# Push Notifications (Web Push)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:noreply@anqor.com

# GDPR Compliance
GDPR_SECRET=your-gdpr-secret-key-keep-this-safe

# Hugging Face (AI Model Inference)
HUGGING_FACE_TOKEN=your-hugging-face-token

# ML Service
ML_SERVICE_URL=http://localhost:5000