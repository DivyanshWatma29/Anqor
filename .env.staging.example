# ==========================================
# STAGING ENVIRONMENT CONFIGURATION
# Mirrors production but with separate resources
# ==========================================

# Application
NODE_ENV=staging
PORT=8788

# Supabase (Staging Project - SEPARATE from production!)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Client-side (VITE_ prefix required)
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key
VITE_API_BASE_URL=https://staging.anqor.com

# Session Security (Different from production!)
SESSION_SECRET=staging-session-secret-change-me
JWT_SECRET=staging-jwt-secret-change-me

# OAuth (Optional - can reuse production if separate not needed)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Monitoring (Separate project for staging)
SENTRY_DSN=your-staging-sentry-dsn
POSTHOG_API_KEY=your-staging-posthog-key

# Email Service (Use test keys for staging)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Resend (Staging - use test keys)
RESEND_API_KEY=your-staging-resend-api-key
RESEND_FROM_EMAIL=Anqor <noreply-staging@anqor.com>

# Push Notifications (Web Push - staging)
VAPID_PUBLIC_KEY=your-staging-vapid-public-key
VAPID_PRIVATE_KEY=your-staging-vapid-private-key
VAPID_SUBJECT=mailto:noreply-staging@anqor.com

# GDPR Compliance
GDPR_SECRET=your-staging-gdpr-secret-key

# Hugging Face (Staging)
HUGGING_FACE_TOKEN=your-staging-hugging-face-token

# ML Service
ML_SERVICE_URL=http://localhost:5000
